-/* -----------------------------------------------------------------------
-   Two suns + light rays.
-   Sun A is fixed at a constant angle. Sun B's angle is set by the rotary
-   dial. Both suns sit on the same arc radius around their own pot's
-   origin — chosen with a verified safety margin so neither sun's visual
-   extent can reach the wall even at the angle cap.
-   ----------------------------------------------------------------------- */
-const SUN_ARC_RADIUS = 150;
-const SUN_ANGLE_CAP  = 55;   // degrees either side — matches MAX_BEND directly now (previously 80, giving a 30deg dead zone beyond the bend cap)
-const SUN_A_ANGLE    = 0;    // fixed — directly overhead, straight down to the plant
-let sunBAngleDeg = 22;       // dial-controlled — the sun's own position follows this instantly
-let effectiveTargetBendRight = clampToMaxBend(sunBAngleDeg); // the PLANT's response — eases toward the clamped goal over real time, not instant
-let smoothRAF = null;
-
-function stepSmoothBend(now) {
-  const goal = clampToMaxBend(sunBAngleDeg);
-  const diff = goal - effectiveTargetBendRight;
-  if (Math.abs(diff) > 0.08) {
-    effectiveTargetBendRight += diff * 0.01; // ~9-11s to settle depending on swing size — deliberately slow
-    render();
-    smoothRAF = requestAnimationFrame(stepSmoothBend);
-  } else {
-    effectiveTargetBendRight = goal;
-    render();
-    smoothRAF = null;
-  }
-}
