-function updateMagLabel() {
-  // Only the coleoptile is a candidate — roots don't participate in
-  // phototropism, so the magnifier has nothing to show for them.
-  const candidates = [
-    { key: "leftColeoptile",  name: "Coleoptile Tip", pot: "left"  },
-    { key: "rightColeoptile", name: "Coleoptile Tip", pot: "right" },
-  ];
-  const labelEl = document.getElementById("magLabelText");
-
-  // Sticky lock: if already locked onto an organ, keep tracking that
-  // SAME organ's tip precisely as long as it's still within range —
-  // regardless of how far its own bending has moved it — rather than
-  // re-picking whichever organ happens to be nearest every frame. The
-  // lock only releases if the magnifier itself is dragged far enough
-  // that even the locked organ falls outside the threshold.
-  if (lockedOrganKey) {
-    const locked = candidates.find((c) => c.key === lockedOrganKey);
-    const p = locked && tipPositions[locked.key];
-    if (p) {
-      const d = Math.hypot(p.x - magX, p.y - magY);
-      if (d < MAG_TIP_THRESHOLD) {
-        labelEl.textContent = locked.name;
-        magOrganMatch = locked;
-        magMatchedPoint = p;
-        return;
-      }
-    }
-    lockedOrganKey = null; // locked organ moved out of range or vanished — fall through to re-search
-  }
-
-  let best = null, bestDist = Infinity, bestPoint = null;
-  candidates.forEach((c) => {
-    const p = tipPositions[c.key];
-    if (!p) return;
-    const d = Math.hypot(p.x - magX, p.y - magY);
-    if (d < bestDist) { bestDist = d; best = c; bestPoint = p; }
-  });
-  if (best && bestDist < MAG_TIP_THRESHOLD) {
-    labelEl.textContent = best.name;
-    magOrganMatch = best;
-    magMatchedPoint = bestPoint;
-    lockedOrganKey = best.key;
-  } else {
-    labelEl.textContent = "";
-    magOrganMatch = null;
-    magMatchedPoint = null;
-    lockedOrganKey = null;
-  }
-}
