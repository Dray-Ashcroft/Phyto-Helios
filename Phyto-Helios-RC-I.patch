-const SUN_PARTICLE_COUNT    = 26;
-const SUN_PARTICLE_MIN_DIST = 14;  // just outside the sun's core disk (r=17)
-const SUN_PARTICLE_MAX_DIST = 95;  // longer rays — the wall's z-order occlusion already
-                                    // handles any that would extend past it, at any length
-const SUN_RAY_TRAIL_LEN     = 14;  // streak length, drawn as a line rather than a dot
