+  const w = Math.round(1 / DT);   // ±1 h window
+  for (let i = 0; i < src.length; i++) { const a = Math.max(0, i - w), b = Math.min(src.length - 1, i + w); r[i] = b > a ? (src[b] - src[a]) / ((b - a) * DT) : 0; }
