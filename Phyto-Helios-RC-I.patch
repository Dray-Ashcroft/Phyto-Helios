-const FILL_UPPER = ["#7a9c5c", "#84a769"];
-const FILL_LOWER = ["#6a8a50", "#749760"];
-
-let CELL_PATHS = [];
-let boostedEdgePts = []; // outer boundary of whichever side is currently elongating — auxin targets these directly
-let magX = 150, magY = 150, magScale = 1, magDragging = false, magAnimId = null;
