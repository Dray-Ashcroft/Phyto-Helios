-function updateCellGrid(stim, curlAngle, boostUpper) {
-  if (!CELL_PATHS.length) return;
-  const centerline = [];
-  for (let i = 0; i <= RIGID_STEPS; i++) {
-    const x = LEFT_MESH_X + (RIGID_BOUNDARY_X - LEFT_MESH_X) * (i / RIGID_STEPS);
-    centerline.push({ x, y: 0, rad: 0 });
-  }
-  const zoneLen = TIP_MESH_X - RIGID_BOUNDARY_X;
-  const segLen = zoneLen / CURL_STEPS;
-  let cx = RIGID_BOUNDARY_X, cy = 0;
-  for (let i = 1; i <= CURL_STEPS; i++) {
-    const s = i / CURL_STEPS;
-    const rad = toRad(smoothstep(s) * curlAngle);
-    cx += Math.cos(rad) * segLen;
-    cy += Math.sin(rad) * segLen;
-    centerline.push({ x: cx, y: cy, rad });
-  }
-  const M = centerline.length;
-  const upperB = []; for (let k = 0; k <= N_UPPER; k++) upperB.push(new Array(M));
-  const lowerB = []; for (let k = 0; k <= N_LOWER; k++) lowerB.push(new Array(M));
-
-  for (let i = 0; i < M; i++) {
-    const pt = centerline[i];
-    const s = i <= RIGID_STEPS ? 0 : (i - RIGID_STEPS) / CURL_STEPS;
-    let taper = 1;
-    if (s > 0.5) taper = 1 - smoothstep((s - 0.5) / 0.5) * 0.85;
-    const growthRamp = smoothstep(s);
-    const boost = 1 + stim * 0.9 * growthRamp;
-
-    const upperExtent = BASE_ROW_H * N_UPPER * taper * (boostUpper ? boost : 1);
-    const lowerExtent = BASE_ROW_H * N_LOWER * taper * (boostUpper ? 1 : boost);
-    const upX = Math.sin(pt.rad), upY = -Math.cos(pt.rad);
-    const dnX = -Math.sin(pt.rad), dnY = Math.cos(pt.rad);
-
-    for (let k = 0; k <= N_UPPER; k++) {
-      const d = (upperExtent / N_UPPER) * k;
-      upperB[k][i] = { x: pt.x + upX * d, y: pt.y + upY * d };
-    }
-    for (let k = 0; k <= N_LOWER; k++) {
-      const d = (lowerExtent / N_LOWER) * k;
-      lowerB[k][i] = { x: pt.x + dnX * d, y: pt.y + dnY * d };
-    }
-  }
-
-  // Outer edge of the elongating side, from the curl/tip zone onward
-  // (skipping the still-rigid base) — the actual cell boundary the
-  // auxin is stimulating, not an abstract shape unrelated to the mesh.
-  boostedEdgePts = [];
-  for (let i = RIGID_STEPS; i < M; i++) {
-    boostedEdgePts.push(boostUpper ? upperB[N_UPPER][i] : lowerB[N_LOWER][i]);
-  }
-
-  CELL_PATHS.forEach(({ el, row, col }) => {
-    let p1, p2, p3, p4;
-    if (row < N_UPPER) {
-      const k = N_UPPER - row, kIn = k - 1;
-      p1 = upperB[k][col];   p2 = upperB[k][col + 1];
-      p3 = upperB[kIn][col + 1]; p4 = upperB[kIn][col];
-    } else {
-      const r = row - N_UPPER;
-      p1 = lowerB[r][col];       p2 = lowerB[r][col + 1];
-      p3 = lowerB[r + 1][col + 1]; p4 = lowerB[r + 1][col];
-    }
-    // Rounded rect centered on the quad's centroid, sized/oriented from
-    // the same corner points — biologically closer to real plant cells
-    // than sharp-cornered quads. Same technique used on the hydrotropism
-    // magnifier.
-    const cx = (p1.x + p2.x + p3.x + p4.x) / 4, cy = (p1.y + p2.y + p3.y + p4.y) / 4;
-    const wx = p2.x - p1.x, wy = p2.y - p1.y;
-    const hx = p4.x - p1.x, hy = p4.y - p1.y;
-    const width = Math.hypot(wx, wy), height = Math.hypot(hx, hy);
-    const angleDeg = (Math.atan2(wy, wx) * 180) / Math.PI;
-    const shrink = 0.86;
-    const rectW = width * shrink, rectH = height * shrink;
-    const corner = Math.min(rectW, rectH) * 0.28;
-    el.setAttribute("x", (-rectW / 2).toFixed(2));
-    el.setAttribute("y", (-rectH / 2).toFixed(2));
-    el.setAttribute("width", rectW.toFixed(2));
-    el.setAttribute("height", rectH.toFixed(2));
-    el.setAttribute("rx", corner.toFixed(2));
-    el.setAttribute("ry", corner.toFixed(2));
-    el.setAttribute("transform", `translate(${cx.toFixed(2)} ${cy.toFixed(2)}) rotate(${angleDeg.toFixed(1)})`);
-  });
-}
