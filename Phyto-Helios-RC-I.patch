-function initCellGrid() {
-  const g = document.getElementById("magCellGrid");
-  if (!g) return;
-  g.innerHTML = "";
-  CELL_PATHS = [];
-  const NS = "http://www.w3.org/2000/svg";
-  const nCols = RIGID_STEPS + CURL_STEPS;
-  for (let r = 0; r < N_UPPER + N_LOWER; r++) {
-    for (let c = 0; c < nCols; c++) {
-      const el = document.createElementNS(NS, "rect");
-      const isUpper = r < N_UPPER;
-      el.setAttribute("fill", isUpper ? FILL_UPPER[c % 2] : FILL_LOWER[c % 2]);
-      el.setAttribute("stroke", "rgba(30,40,20,0.5)");
-      el.setAttribute("stroke-width", "0.6");
-      g.appendChild(el);
-      CELL_PATHS.push({ el, col: c, row: r });
-    }
-  }
-}
