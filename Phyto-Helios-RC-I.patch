 assets/screenshots/04-mobile.png    |  Bin 0 -> 351259 bytes
 css/style.css                       |  385 ++++++
 index.html                          | 1503 ++++------------------
 js/app.js                           | 1784 +++++++++++++++++++++++++++
 14 files changed, 2393 insertions(+), 1284 deletions(-)
 delete mode 100644 assets/Gitkeep
 create mode 100644 assets/models/avocado.glb
 create mode 100644 assets/models/magnifier.glb
 create mode 100644 assets/models/stem.glb
 create mode 100644 assets/models/sun.glb
 create mode 100644 assets/models/sundial.glb
 create mode 100644 assets/screenshots/01-overview.png
