+    let m = 0; for (const a of set) m += a[i]; m /= n;
+    let v = 0; for (const a of set) v += (a[i] - m) ** 2;
+    mean[i] = m; sd[i] = Math.sqrt(v / (n - 1));
+  }
+  return { mean, sd };
