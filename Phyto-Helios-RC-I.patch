+  const N = Math.round(MAX_HOURS / DT), out = new Float32Array(N + 1);
+  let th = 0, s = 0;
+  for (let i = 1; i <= N; i++) {
+    const h = i * DT;
+    const now = settingsAt(h);
+    const lag = lagFor(now.I) * sp.lag;
+    let u = 0;
+    if (h > lag) {
+      const seen = settingsAt(h - lag);
+      if (lightOn(h - lag, seen)) {
+        const boost = seen.mode === "pulse" ? PULSE_BOOST : 1;
