-// at MAX_BEND in EITHER curl direction (both computed, not assumed symmetric).
-const CLIP_OUTLINE_D = `M ${LEFT_MESH_X - 6} -80 L ${TIP_MESH_X + 27} -80 L ${TIP_MESH_X + 27} 80 L ${LEFT_MESH_X - 6} 80 Z`;
