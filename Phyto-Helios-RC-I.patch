-function createSunParticles(hostId) {
-  const host = document.getElementById(hostId);
-  host.innerHTML = "";
-  const particles = [];
-  for (let i = 0; i < SUN_PARTICLE_COUNT; i++) {
-    // Fixed, evenly-spaced angle for every particle — no jitter, no drift
-    // on respawn — so each one repeatedly traces the exact same straight
-    // line outward, reading as a ray rather than a wandering spark.
-    const angle = (i / SUN_PARTICLE_COUNT) * Math.PI * 2;
-    const dist = SUN_PARTICLE_MIN_DIST + Math.random() * (SUN_PARTICLE_MAX_DIST - SUN_PARTICLE_MIN_DIST);
-    const speed = 0.55 + Math.random() * 0.35;
-    const el = document.createElementNS("http://www.w3.org/2000/svg", "line");
-    el.setAttribute("stroke", "#ffe9a8");
-    el.setAttribute("stroke-width", "2");
-    el.setAttribute("stroke-linecap", "round");
-    host.appendChild(el);
-    particles.push({ angle, dist, speed, el });
-  }
-  return particles;
-}
-
-function stepSunParticles(particles) {
-  particles.forEach((p) => {
-    p.dist += p.speed;
-    if (p.dist > SUN_PARTICLE_MAX_DIST) {
-      p.dist = SUN_PARTICLE_MIN_DIST; // same fixed angle — stays the same straight-line ray
-    }
-    const frac = (p.dist - SUN_PARTICLE_MIN_DIST) / (SUN_PARTICLE_MAX_DIST - SUN_PARTICLE_MIN_DIST);
-    const opacity = (1 - frac) * 0.8 + 0.15; // fades as it travels outward
-    const innerDist = Math.max(SUN_PARTICLE_MIN_DIST, p.dist - SUN_RAY_TRAIL_LEN);
-    const cosA = Math.cos(p.angle), sinA = Math.sin(p.angle);
-    p.el.setAttribute("x1", (cosA * innerDist).toFixed(1));
-    p.el.setAttribute("y1", (sinA * innerDist).toFixed(1));
-    p.el.setAttribute("x2", (cosA * p.dist).toFixed(1));
-    p.el.setAttribute("y2", (sinA * p.dist).toFixed(1));
-    p.el.setAttribute("opacity", opacity.toFixed(2));
-  });
-}
