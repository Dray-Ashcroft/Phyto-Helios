 create mode 100644 css/style.css
 create mode 100644 js/app.js

diff --git a/README.md b/README.md
index de2e5ad..d820a2e 100644
--- a/README.md
+++ b/README.md
@@ -1,5 +1,5 @@
 <p align="center">
-  <img src="assets/banner.png" alt="Phyto Helios: two seedlings under separate suns, divided by a light-tight partition" width="100%" />
+  <img src="assets/repo-banner.png" alt="Phyto Helios: two seedlings under separate suns, divided by a light-tight partition" width="100%" />
 </p>
 
 <h1 align="center">Phyto Helios</h1>
@@ -146,6 +146,6 @@ All models were optimised for the web (geometry simplified, textures resized). T
 
 ## License
 
-Source code © 2026 Sai Prasad. 3D models remain under their creators' licences listed above.
+Source code is released under the [GNU General Public License v3.0](LICENSE). 3D models remain under their creators' licences listed above.
 
 <p align="center"><sub><a href="https://github.com/Dray-Ashcroft/Phyto-Helios">GitHub</a></sub></p>
